<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unity-free core of Saucy Menu: module registry, room gate, settings, search,
    themes and the menu state machine. It has no game or Unity references so it
    can be unit-tested on any machine. The plugin project compiles these same
    source files into the single shipped DLL.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SaucyMenu.Core</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gorilla Tag ships Newtonsoft.Json 13.x (assembly version 13.0.0.0); compile against the same major. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
