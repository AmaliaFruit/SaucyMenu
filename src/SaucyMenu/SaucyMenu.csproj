<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SaucyMenu</AssemblyName>
    <RootNamespace>SaucyMenu</RootNamespace>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <Version>0.1.0</Version>

    <!-- Off by default: nothing is copied into the game unless you ask for it. -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>

  <!-- The Unity-free core is compiled into this one DLL so there is a single file to install. -->
  <ItemGroup>
    <Compile Include="..\SaucyMenu.Core\**\*.cs" Exclude="..\SaucyMenu.Core\obj\**;..\SaucyMenu.Core\bin\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')"
           Text="Gorilla Tag not found (looked in '$(GameManagedDir)'). Set GamePath - see Directory.Build.props." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')"
           Text="BepInEx not found (looked in '$(BepInExCoreDir)'). Install BepInEx 5 into the game first." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(GameManagedDir)\UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonUnityNetworking"><HintPath>$(GameManagedDir)\PhotonUnityNetworking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonRealtime"><HintPath>$(GameManagedDir)\PhotonRealtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Photon3Unity3D"><HintPath>$(GameManagedDir)\Photon3Unity3D.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Opt-in only: dotnet build -c Release -p:DeployToGame=true -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPluginsDir)\SaucyMenu" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(BepInExPluginsDir)\SaucyMenu" />
  </Target>
</Project>
